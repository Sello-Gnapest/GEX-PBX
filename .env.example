# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -------------------------------------------------------------------
# GEX PBX Network Provider Configuration
# -------------------------------------------------------------------
# These values are safe to keep in .env.local or runtime secrets.
# Do not commit real production credentials to Git.
# For Vite client-side use, prefix with VITE_.
# For backend/API use, keep unprefixed variables and read them server-side.

VITE_PBX_PRIMARY_PROVIDER_ID="prov-telkom"
VITE_PBX_DEFAULT_REGION="Durban"
VITE_PBX_DEFAULT_AREA_CODE="031"

# Telkom
VITE_PROVIDER_TELKOM_HOST="sip.kzn.telkom.co.za"
VITE_PROVIDER_TELKOM_PORT="5060"
VITE_PROVIDER_TELKOM_PROTOCOL="UDP"
VITE_PROVIDER_TELKOM_USERNAME="kzn-031-tr-9408800"
VITE_PROVIDER_TELKOM_PASSWORD="CHANGE_ME"

# Vodacom
VITE_PROVIDER_VODACOM_HOST="ims-dbn.vodacom.co.za"
VITE_PROVIDER_VODACOM_PORT="5061"
VITE_PROVIDER_VODACOM_PROTOCOL="TLS"
VITE_PROVIDER_VODACOM_USERNAME="vodabiz-durban-trunk"
VITE_PROVIDER_VODACOM_PASSWORD="CHANGE_ME"

# MTN
VITE_PROVIDER_MTN_HOST="sip.kzn.mtnbusiness.co.za"
VITE_PROVIDER_MTN_PORT="5060"
VITE_PROVIDER_MTN_PROTOCOL="UDP"
VITE_PROVIDER_MTN_USERNAME="mtn-dbn-sip-994"
VITE_PROVIDER_MTN_PASSWORD="CHANGE_ME"

# Switch Telecom
VITE_PROVIDER_SWITCHTEL_HOST="sip.switchtel.co.za"
VITE_PROVIDER_SWITCHTEL_PORT="5060"
VITE_PROVIDER_SWITCHTEL_PROTOCOL="UDP"
VITE_PROVIDER_SWITCHTEL_USERNAME="swtel-031-pilot"
VITE_PROVIDER_SWITCHTEL_PASSWORD="CHANGE_ME"

# Liquid
VITE_PROVIDER_LIQUID_HOST="sip.liquidtelecom.co.za"
VITE_PROVIDER_LIQUID_PORT="5061"
VITE_PROVIDER_LIQUID_PROTOCOL="TLS"
VITE_PROVIDER_LIQUID_USERNAME="lit-dbn-trunk-01"
VITE_PROVIDER_LIQUID_PASSWORD="CHANGE_ME"

# Shared PBX routing options
VITE_PBX_FAILOVER_ENABLED="true"
VITE_PBX_FAILOVER_THRESHOLD_MS="120"
VITE_PBX_KEEPALIVE_INTERVAL_SECONDS="300"
VITE_PBX_MAX_RETRIES="5"

# Office switchboard settings
VITE_OFFICE_MAIN_NUMBER="031 940 8800"
VITE_OFFICE_SWITCHBOARD_EXT="101"
VITE_OFFICE_VOICEMAIL_NUMBER="*97"
VITE_OFFICE_VOICEMAIL_EMAIL="sello.ncwani@gmail.com"
